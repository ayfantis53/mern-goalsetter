############################################################################################
# Node Building Layer
# This is a MINIMAL RUNTIME image to run Node project
# For testing Goals frontend locally
############################################################################################

# Use Node image as base layer
FROM node:latest

# Create app directory
WORKDIR '/app'

# Install app dependencies
COPY ./package*.json ./
RUN npm install

# Bundle app source
COPY . .

# run app
CMD ["npm", "run", "start"]